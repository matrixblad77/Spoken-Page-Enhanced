# Spoken Page Enhanced
# Shared public-repository ignore rules.
# Keep this file committed so everyone who clones the project gets the same rules.

# Next.js / Node build output
.next/
out/
dist/
node_modules/
*.tsbuildinfo

# Local/runtime data
data/
logs/
*.log

# Environment files / local secrets
.env
.env.local
.env.production
.env.development.local
.env.test.local

# Local certificates and test data
certificates/
.test-data/

# Next.js review / fixture output
.next-review/
.next-build-check/
.next-fixture-next/

# OS/editor junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local upgrade backups created while maintaining custom files
*.before-*.tsx
*.before-*.ts
*.before-*.css
*.before-*.md
*.backup
*.bak

# Private sharing drafts / local notes
REDDIT-SHARE-README.md
PRIVATE-*.md

# Local UI review captures; retain the isolated fixture illustration.
docs/*.png
!docs/phase-0-2-review.png

# Optional local release/artifact folders.
# Put public binaries in GitHub Releases rather than committing build output.
release-local/
artifacts-local/

# Local Enhanced backups - never publish
_enhanced-backups/
